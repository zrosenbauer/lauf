{
  "name": "lauf-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "rimraf **/dist **/.turbo **/node_modules/.cache",
    "clean:all": "pnpm clean && rimraf **/node_modules pnpm-lock.yaml",
    "docs:build": "turbo run docs:build --filter=docs",
    "docs:dev": "turbo run docs:dev --filter=docs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "lefthook install",
    "release": "changeset publish",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "validate": "turbo run typecheck test lint fmt:check",
    "version": "changeset version",
    "version:ci": "changeset version && oxfmt --write"
  },
  "dependencies": {
    "laufen": "workspace:*"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "eslint-plugin-functional": "^9.0.4",
    "eslint-plugin-security": "^4.0.0",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "rimraf": "^6.1.3",
    "turbo": "^2.9.14"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  }
}
