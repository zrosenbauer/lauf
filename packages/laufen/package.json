{
  "name": "laufen",
  "version": "1.3.1",
  "description": "Typed script runner for monorepos — discover, validate, and execute TypeScript scripts with Zod-powered arguments",
  "keywords": [
    "bun",
    "cli",
    "lerna",
    "monorepo",
    "npm",
    "script-runner",
    "task-runner",
    "typescript",
    "workspace",
    "yarn",
    "zod"
  ],
  "homepage": "https://github.com/zrosenbauer/lauf#readme",
  "bugs": {
    "url": "https://github.com/zrosenbauer/lauf/issues"
  },
  "license": "MIT",
  "author": "Zac Rosenbauer",
  "repository": {
    "type": "git",
    "url": "https://github.com/zrosenbauer/lauf.git"
  },
  "bin": {
    "lauf": "./bin/lauf.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lauf.d.mts",
      "import": "./dist/lauf.mjs",
      "default": "./dist/lauf.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "echo 'laufen is an aggregator; tests live in @laufen/config, @laufen/cli, @laufen/engine' && exit 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@laufen/cli": "workspace:*",
    "@laufen/config": "workspace:*",
    "@laufen/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "tsdown": "^0.21.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
