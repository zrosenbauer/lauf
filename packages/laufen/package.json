{
  "name": "laufen",
  "version": "1.1.0",
  "description": "Typed script runner for monorepos — discover, validate, and execute TypeScript scripts with Zod-powered arguments",
  "keywords": [
    "bun",
    "cli",
    "lerna",
    "monorepo",
    "npm",
    "script-runner",
    "task-runner",
    "typescript",
    "workspace",
    "yarn",
    "zod"
  ],
  "homepage": "https://github.com/zrosenbauer/lauf#readme",
  "bugs": {
    "url": "https://github.com/zrosenbauer/lauf/issues"
  },
  "license": "MIT",
  "author": "Zac Rosenbauer",
  "repository": {
    "type": "git",
    "url": "https://github.com/zrosenbauer/lauf.git"
  },
  "bin": {
    "lauf": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lauf.d.mts",
      "import": "./dist/lauf.mjs",
      "default": "./dist/lauf.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "@laufen/engine": "workspace:*",
    "c12": "4.0.0-beta.3",
    "chalk": "^5.6.2",
    "clerc": "^1.3.1",
    "dotenv": "^17.3.1",
    "es-toolkit": "^1.44.0",
    "fast-glob": "^3.3.3",
    "jiti": "^2.6.1",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.3",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/picomatch": "^4.0.2",
    "@vitest/coverage-v8": "^4.0.18",
    "tsdown": "^0.20.3",
    "type-fest": "^5.4.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
